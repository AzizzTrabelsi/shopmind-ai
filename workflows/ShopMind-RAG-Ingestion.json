    {
      "parameters": {
        "jsCode": "function normalizeKeys(row) {\n  const out = {};\n  for (const k in row) out[k.replace(/^\\uFEFF/, '').trim()] = row[k];\n  return out;\n}\nconst FX_INR_TO_TND = 0.0378;\nconst parsePrice = (raw) => {\n  if (raw == null) return null;\n  const n = parseFloat(String(raw).replace(/[₹$,]/g, '').trim());\n  return isNaN(n) ? null : n;\n};\nconst toTND = (v) => v == null ? null : +(v * FX_INR_TO_TND).toFixed(2);\n\nreturn $input.all().map(item => {\n  const row = item.json;\n  const price_tnd = toTND(parsePrice(row.price));\n  const pageContent = `Smartphone: ${row.brand_name} ${row.model}\nReleased ${row.release_year}, runs ${row.operating_system}.\nDisplay: ${row.screen_size}\" screen, ${row.refresh_rate}Hz refresh rate.\nPerformance: ${row.chipset} chipset with ${row.gpu}, ${row.ram}GB RAM, ${row.storage}GB storage.\nCamera: ${row.camera_mp}MP rear / ${row.front_camera_mp}MP front.\nBattery: ${row.battery_capacity}mAh, fast charging ${row.fast_charging}W.\nConnectivity: ${row.network_support}, Bluetooth ${row.bluetooth_version}, ${row.wifi_version}, ${row.usb_type}.\nBody: ${row.body_material}, ${row.weight}g, ${row.thickness}mm, fingerprint sensor: ${row.fingerprint_sensor}.\nPrice: ${price_tnd} TND.`;\n\n  return {\n    json: {\n      pageContent,\n      metadata: {\n        category: 'smartphone',\n        brand: row.brand_name,\n        model: row.model,\n        price_tnd,\n        source_dataset: 'smartphones.csv',\n        source_id: String(row.id)\n      }\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        640,
        -192
